generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_FILE_NAME")
}

model User {
  // Adaptive AI platform columns (do not change)
  id     String  @id
  name   String?
  image  String?
  handle String?

  // Additional columns can be added here

  // Relations
  selectedRocket      String  @default("rocket_1")
  maxAltitude         Int     @default(0)
  stars               Int     @default(0)
  totalStarsCollected Int     @default(0)
  totalFlights        Int     @default(0)
  totalSurvivalTime   Int     @default(0) // in seconds

  // Relations
  role                String  @default("PLAYER") // ADMIN | PLAYER
}
